# =============================================================================
# SmartAttend AI — Environment Configuration
# Copy this file to ".env" in the project root and fill in real values.
# NEVER commit the real .env file.
# =============================================================================

# ---- App ----
APP_NAME=SmartAttend AI
APP_ENV=development          # development | production
DEBUG=true
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# ---- API ----
API_V1_PREFIX=/api
# Comma-separated list of allowed frontend origins for CORS.
# For local dev with the built-in static server this is typically:
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# ---- Database (MongoDB) ----
# Local dev example:   mongodb://localhost:27017
# MongoDB Atlas example: mongodb+srv://<user>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=smartattend_ai

# ---- Authentication / JWT ----
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-this-to-a-long-random-secret-before-any-real-deployment
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---- Computer Vision / Attendance Policy ----
# Used by the Phase 2/3 CV pipeline. All defaults below are placeholders —
# they MUST be recalibrated against the selected recognition model and real
# enrollment data before this is used for anything beyond local testing.
# See docs/computer-vision.md.
FACE_RECOGNITION_THRESHOLD=0.60
LOW_CONFIDENCE_THRESHOLD=0.45
LIVENESS_THRESHOLD=0.50
RECOGNITION_COOLDOWN_SECONDS=30

INSIGHTFACE_MODEL_PACK=buffalo_l
INSIGHTFACE_PROVIDERS=CPUExecutionProvider
INSIGHTFACE_DET_SIZE=640
MIN_FACE_QUALITY_SCORE=0.55
MIN_FACE_SIZE_RATIO=0.12
MAX_BLUR_VARIANCE_FLOOR=60.0
MAX_YAW_DEGREES_FOR_ENROLLMENT=20.0

LIVENESS_YAW_DELTA_DEGREES=12.0
LIVENESS_TIMEOUT_SECONDS=20
LIVENESS_SESSION_TTL_SECONDS=60

DEFAULT_LATE_THRESHOLD_MINUTES=10

# ---- Retention (Phase 10) ----
# Deletion still requires an admin to explicitly enable
# retention_enforcement_enabled in Settings — this interval alone does nothing.
RETENTION_CHECK_INTERVAL_HOURS=24
